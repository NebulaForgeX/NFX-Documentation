# ============================================
# NFX-Documentation 项目 .gitignore
# ============================================

# 环境配置文件（包含实际配置信息）
.env

# 日志文件
*.log
logs/
*.log.*

# 备份文件
*.bak
*.backup
*.old
*.tmp
*~

# 系统文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 编辑器文件
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# 临时文件
*.tmp
*.temp
.cache/

# ============================================
# NFX-Documentation Web 服务相关
# ============================================

# console
console/node_modules/
console/dist/
console/dist-ssr
console/*.local
console/.env.local
console/.env.*.local
console/logs
console/*.log
console/npm-debug.log*
console/yarn-debug.log*
console/yarn-error.log*
console/pnpm-debug.log*
console/lerna-debug.log*

