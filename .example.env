# ============================================
# NFX-Documentation 环境变量配置示例
# ============================================
# 复制此文件为 .env 并根据实际情况修改配置
# cp .example.env .env
#
# HTTP 入口只有 NFX-Edge；本栈不跑 Traefik。
# 浏览器：/<console host>/documentation/
# 容器内 nginx：/nfx-documentation/

# ============================================
# 与 Identity / Edge 同一个控制台 Host
# ============================================
TRAEFIK_CONSOLE_HOST=identity.nebulaforgex.com

# 浏览器路径（Vite base）。容器内由 Traefik 改写成 /nfx-documentation/
VITE_BASE=/documentation/

# ============================================
# 构建期后端占位（文档站前端镜像 ARGS）
# ============================================
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
