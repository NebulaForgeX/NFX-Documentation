# ============================================
# NFX-Documentation 环境变量配置示例
# ============================================
# 复制此文件为 .env 并根据实际情况修改配置
# cp .example.env .env
#
# HTTP 入口只有 NFX-Edge；本栈不跑 Traefik。
# 浏览器与容器内都是 /console/nfx-documentation/

# ============================================
# 与 Identity / Edge 同一个控制台 Host
# ============================================

# 浏览器路径（Vite base），与其它 console 相同。

# LAN publish address. GRPC_HOST_* defaults to this machine; point one key at NAS2 when that service moves.
NAS_IP=192.168.1.64
HTTP_EXT_PORT_FRONTEND=10120
VITE_BASE=/console/nfx-documentation/

# ============================================
# 构建期后端占位（文档站前端镜像 ARGS）
# ============================================
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
